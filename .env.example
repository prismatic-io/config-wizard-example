# Prismatic embedded credentials (server-only — never exposed to the browser)

# Your Prismatic organization ID (Org Settings → Embedded tab)
PRISMATIC_ORG_ID=

# RSA private signing key in PEM format. Generate one with:
#   prism organization:signing-keys:generate
# Paste the full PEM. Either a quoted multi-line value or a single line with \n
# escapes works (the token route normalizes \n back to newlines):
#   PRISMATIC_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
PRISMATIC_SIGNING_KEY=

# Hardcoded demo customer/user for this barebones example. In a real app these
# come from your authenticated session, not env vars.
PRISMATIC_CUSTOMER_EXT_ID=demo-customer
PRISMATIC_CUSTOMER_NAME=Demo Customer
PRISMATIC_DEMO_USER_ID=demo-user-1
PRISMATIC_DEMO_USER_NAME=Demo User
